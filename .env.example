# VibeVerse AI Environment Configuration
# Copy this file to .env and fill in your local values. Never commit .env.

# --- Application ---
APP_NAME=VibeVerse AI
APP_ENV=development
LOG_LEVEL=INFO

# --- MySQL Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vibeverse_ai
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
# Optional full override URL (if set, takes precedence over individual MYSQL_* fields)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/vibeverse_ai?charset=utf8mb4

# --- FastAPI Backend ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- External APIs (Optional - App works offline using local datasets & cache) ---
# Mode options: auto | api | local | cache
DATA_MODE=auto
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=VibeVerseAI/1.0 (https://localhost)

# --- Paths & Cache ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CACHE_DIR=data/cache
CACHE_TTL_HOURS=72
